# Environment Mode
FLASK_ENV=development
PORT=5000

# Secret Keys
SECRET_KEY=farmer-crop-advisory-secret-key-change-me-in-production
JWT_SECRET_KEY=jwt-secret-advisory-token-change-me-in-production
JWT_EXPIRES_HOURS=24

# Database URL (leave empty for automatic SQLite file in backend/database/farmer_advisory.db)
DATABASE_URL=
# For PostgreSQL (production):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/farmer_advisory_db

# External Weather API
WEATHER_API_KEY=

# Demo Mode: enabled by default for zero-friction demonstration
DEMO_MODE=true

# Frontend URL
FRONTEND_URL=http://localhost:3000
