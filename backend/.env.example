# Environment Mode
FLASK_ENV=development
PORT=5000

# Secret Keys (Change in production)
SECRET_KEY=farmer-crop-advisory-secret-key-change-me-in-production
JWT_SECRET_KEY=jwt-secret-advisory-token-change-me-in-production
JWT_EXPIRES_HOURS=24

# Database URL
# For SQLite (default development):
DATABASE_URL=sqlite:///database/farmer_advisory.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/farmer_advisory_db

# External Weather API (OpenWeatherMap free API key)
# Obtain a free key from https://openweathermap.org/api
WEATHER_API_KEY=

# Demo Mode: Set to true to use rich mock fallback data when API keys are not supplied
DEMO_MODE=true

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
